# VoiceScript local configuration
#
# Copy this file to .env and adjust paths for your local machine.

VOICESCRIPT_API_KEY=
VOICESCRIPT_DATA_DIR=data
VOICESCRIPT_INLINE_JOBS=false
VOICESCRIPT_MAX_UPLOAD_SIZE_BYTES=524288000
VOICESCRIPT_MAX_BATCH_FILES=25

# If ffmpeg/ffprobe are not on PATH, point directly to the installed binaries.
VOICESCRIPT_FFMPEG=ffmpeg
VOICESCRIPT_FFPROBE=ffprobe

VOICESCRIPT_SILENCE_NOISE_DB=-50dB
VOICESCRIPT_SILENCE_MIN_DURATION_SECONDS=2
VOICESCRIPT_LOW_VOLUME_THRESHOLD_DB=-30

# Speech provider values: local, onnx, local-onnx, disabled, huggingface, api, other
# Source separation provider values: local, disabled, huggingface, api, other
# Nonlocal provider names are configurable stubs in this version unless you add an adapter.
VOICESCRIPT_TRANSCRIPTION_PROVIDER=local
VOICESCRIPT_DIARIZATION_PROVIDER=local
VOICESCRIPT_SOURCE_SEPARATION_PROVIDER=local
VOICESCRIPT_WHISPER_MODEL=small
VOICESCRIPT_WHISPER_DEVICE=auto
VOICESCRIPT_WHISPER_COMPUTE_TYPE=int8
VOICESCRIPT_PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
PYANNOTE_AUTH_TOKEN=

# ONNX speech model configuration. Fetch is disabled by default; put model files in the cache dir or opt in.
VOICESCRIPT_ONNX_MODEL_DIR=data/models
VOICESCRIPT_ONNX_FETCH_ENABLED=false
VOICESCRIPT_MODEL_FETCH_POLICY=local_only
VOICESCRIPT_WHISPER_ONNX_MODEL=whisper.onnx
VOICESCRIPT_WHISPER_ONNX_REPO_ID=
VOICESCRIPT_PYANNOTE_ONNX_MODEL=pyannote.onnx
VOICESCRIPT_PYANNOTE_ONNX_REPO_ID=
VOICESCRIPT_ONNX_EXECUTION_PROVIDER=CPUExecutionProvider

VOICESCRIPT_DEMUCS_ENABLED=true
VOICESCRIPT_DEMUCS_MODEL=htdemucs
